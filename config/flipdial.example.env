# Copy to .env and fill in. Never commit .env.
# All values here are placeholders.

# Server: keep on localhost unless a reverse proxy with sign-in sits in front
FLIPDIAL_HOST=127.0.0.1
FLIPDIAL_PORT=8080

# Sign-in (see docs/sign-in.md): none, oidc or proxy
FLIPDIAL_AUTH_MODE=none
# FLIPDIAL_ALLOW_NO_AUTH=false   # only for a port reachable from this machine alone
# FLIPDIAL_PUBLIC_URL=https://flipdial.example.lan
# FLIPDIAL_AUTH_ALLOWED_USERS=you@example.com
# FLIPDIAL_OIDC_ISSUER=https://sso.example.lan/application/o/flipdial
# FLIPDIAL_OIDC_CLIENT_ID=flipdial
# FLIPDIAL_OIDC_CLIENT_SECRET=
# FLIPDIAL_SESSION_IDLE_HOURS=12
# FLIPDIAL_SESSION_MAX_DAYS=7
# FLIPDIAL_PROXY_USER_HEADER=Remote-User
# FLIPDIAL_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Storage
FLIPDIAL_DATA_DIR=./data
# FLIPDIAL_INBOX_DIR=/path/to/inbox
# FLIPDIAL_ARCHIVE_DIR=/path/to/archive

# Ingest: auto, duplex, named or single (see docs/ingest.md)
FLIPDIAL_INGEST_MODE=auto
FLIPDIAL_SETTLE_SECONDS=5
FLIPDIAL_PAIR_TIMEOUT_SECONDS=120
FLIPDIAL_POLL_SECONDS=3
FLIPDIAL_MAX_FILE_MB=50
FLIPDIAL_MAX_PIXELS=60000000
FLIPDIAL_MAX_PDF_PAGES=50
FLIPDIAL_AUTO_CROP=true

# Updates: check GitHub once a day for a newer published release (sends nothing else)
FLIPDIAL_UPDATE_CHECK=true

# Logging: json or text
FLIPDIAL_LOG_LEVEL=INFO
FLIPDIAL_LOG_FORMAT=json

# CardDAV (use an app password, not your main password)
FLIPDIAL_CARDDAV_URL=https://contacts.example.com/carddav/
FLIPDIAL_CARDDAV_USERNAME=
FLIPDIAL_CARDDAV_PASSWORD=
FLIPDIAL_CARDDAV_ADDRESSBOOK=
FLIPDIAL_VCARD_VERSION=3.0
FLIPDIAL_CARDDAV_VERIFY_TLS=true
# FLIPDIAL_CARDDAV_CA_BUNDLE=/path/to/ca.pem

# Phone sync (docs/sync.md): a second address book on the same server for your phone.
# Only contacts you switch on are copied there. Leave empty to keep phone sync off.
FLIPDIAL_PHONE_ADDRESSBOOK=
# Hour of the daily check for edits made on the phone (server time, 0-23).
FLIPDIAL_PHONE_CHECK_HOUR=3
# Without sign-in, FlipDial answers only to addresses, localhost and this computer's name.
# List other names you open it by (comma-separated). This stops other websites from reading
# FlipDial through your browser (DNS rebinding).
# FLIPDIAL_ALLOWED_HOSTS=
# The address phones use for the contacts server, if FlipDial reaches it by another name.
# FLIPDIAL_PHONE_SERVER_URL=https://nas.local:5232/
# FlipDial's own contacts server, if you set one up (docs/contacts-server.md).
# FLIPDIAL_RADICALE_DIR=

# Extraction model. Must be on your local network unless ALLOW_REMOTE_MODEL is true.
FLIPDIAL_MODEL_BACKEND=ollama
FLIPDIAL_MODEL_URL=http://127.0.0.1:11434
FLIPDIAL_MODEL_NAME=qwen3.5:9b
FLIPDIAL_ALLOW_REMOTE_MODEL=false
FLIPDIAL_MODEL_TIMEOUT_SECONDS=120
FLIPDIAL_EXTRACT_MAX_ATTEMPTS=3
