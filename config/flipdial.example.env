# Copy to .env and fill in. Never commit .env.
# All values here are placeholders.

# Server: keep on localhost unless a reverse proxy with sign-in sits in front
FLIPDIAL_HOST=127.0.0.1
FLIPDIAL_PORT=8080

# Storage
FLIPDIAL_DATA_DIR=./data
# FLIPDIAL_INBOX_DIR=/path/to/inbox
# FLIPDIAL_ARCHIVE_DIR=/path/to/archive

# Logging: json or text
FLIPDIAL_LOG_LEVEL=INFO
FLIPDIAL_LOG_FORMAT=json

# CardDAV (use an app password, not your main password)
FLIPDIAL_CARDDAV_URL=https://contacts.example.com/carddav/
FLIPDIAL_CARDDAV_USERNAME=
FLIPDIAL_CARDDAV_PASSWORD=

# Extraction model. Must be on your local network unless ALLOW_REMOTE_MODEL is true.
FLIPDIAL_MODEL_BACKEND=ollama
FLIPDIAL_MODEL_URL=http://127.0.0.1:11434
FLIPDIAL_MODEL_NAME=llama3.2-vision
FLIPDIAL_ALLOW_REMOTE_MODEL=false
